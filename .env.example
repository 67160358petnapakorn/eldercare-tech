# Leave unset for local dev — backend/app/core/config.py already defaults
# to a SQLite file at backend/eldercare.db. Set this to a real Postgres URL
# (postgres:// or postgresql://) in production, or to the MySQL URL below
# when running via docker-compose.
# DATABASE_URL=

ENVIRONMENT=development
# Must be set to a real random value when ENVIRONMENT=production — the app
# refuses to start in production with the insecure default below.
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PROMPTPAY_ID=0812345678

# Seeds the family/caregiver/admin demo accounts and sample data on first
# startup — convenient for local dev and this project's own demo deploy,
# but a real deployment with real users should leave this false.
SEED_DEMO_DATA=true

# Comma-separated extra origins the backend should accept CORS requests
# from, on top of localhost and *.vercel.app (already allowed in main.py).
# Example: ALLOWED_ORIGINS=https://eldercare-tech.vercel.app
ALLOWED_ORIGINS=

# Used by docker-compose.yml's `db` service (MySQL) — only relevant when
# running `docker compose up`.
MYSQL_DATABASE=eldercare
MYSQL_USER=eldercare_user
MYSQL_PASSWORD=eldercare_password
MYSQL_ROOT_PASSWORD=rootpassword

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
